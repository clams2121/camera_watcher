[Unit]
Description=camera_watcher for %i
Documentation=https://github.com/clams2121/camera_watcher
After=network-online.target tailscaled.service
Wants=network-online.target

# Crash-loop protection: if it can't stay up across 5 restarts within 5
# minutes, stop retrying instead of hammering the camera/disk/CPU forever.
# `systemctl status camera-watcher@%i` shows "start-limit-hit" when this
# fires, so it's obvious this happened rather than silently spinning.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=camera-watcher
Group=camera-watcher
WorkingDirectory=/opt/camera-watcher
ExecStart=/opt/camera-watcher/.venv/bin/python -m camera_watcher.main --config /opt/camera-watcher/config/%i.yaml
Restart=on-failure
RestartSec=5

# Hardening -- deliberately conservative given this handles a live network
# stream, credentials, and disk writes as an always-on background service.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# If the service fails to start with this on, it's a reasonable first thing
# to try disabling -- see deploy/README.
MemoryDenyWriteExecute=true

# Config/secrets/mask (rewritten by the web UI's Settings tab) and the
# data_root (clips, the passthrough segment cache, the motion heatmap) are
# the only paths this process needs to write to -- everything else on the
# filesystem stays read-only to it. Adjust these two paths if your install
# doesn't match deploy/README's layout.
ReadWritePaths=/opt/camera-watcher/config /var/lib/camera-watcher

[Install]
WantedBy=multi-user.target
