[Unit]
Description=camera_watcher fleet-wide retention sweep
Documentation=https://github.com/clams2121/camera_watcher

[Service]
Type=oneshot
User=camera-watcher
Group=camera-watcher
WorkingDirectory=/opt/camera-watcher

# --global sweeps every camera subdirectory under the given clips root
# against ONE shared budget -- not per camera. Each clip's age window
# depends on its clip_classifier verdict (see classify_tier() in
# retention.py): --low-max-age-hours for verdict=low, --high-max-age-days
# for verdict=high (and error/not-yet-classified/review+keep, which are
# treated as high), --review-max-age-days for verdict=review clips nobody
# has reviewed yet. Edit these, or --max-total-gb, to your fleet's real
# budget, or override them without touching this file via a drop-in:
#     sudo systemctl edit camera-retention.service
ExecStart=/opt/camera-watcher/.venv/bin/python -m camera_watcher.retention \
    --global /var/lib/camera-watcher/clips \
    --low-max-age-hours 48 \
    --high-max-age-days 30 \
    --review-max-age-days 30 \
    --max-total-gb 500

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/camera-watcher
